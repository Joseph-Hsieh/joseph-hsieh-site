{
  // Cloudflare Workers static-assets deployment for joseph-hsieh.com
  "name": "joseph-hsieh",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "build": {
    "command": "python3 build.py"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "joseph-hsieh.com", "custom_domain": true },
    { "pattern": "www.joseph-hsieh.com", "custom_domain": true }
  ]
}
